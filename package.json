{
  "name": "site-ppc",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "BIND_HOST=127.0.0.1 decap-server",
    "check": "astro check",
    "check:oauth": "tsc --project netlify/oauth/tsconfig.json",
    "test": "vitest run",
    "test:oauth": "vitest run tests/oauth.test.ts",
    "test:redirects": "vitest run tests/netlify-redirects.test.ts",
    "validate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/validate-contenus.ts",
    "referentiel:import": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/importer-referentiel.ts",
    "referentiel:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/verifier-referentiel.ts",
    "build": "astro build",
    "check:dist": "node scripts/verifier-site-genere.mjs",
    "ci": "npm run test && npm run validate && npm run referentiel:check && npm run check && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "decap-server": "^3.11.0",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "yaml": "^2.8.3"
  }
}
