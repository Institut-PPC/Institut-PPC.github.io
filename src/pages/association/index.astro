---
import { getEntry } from 'astro:content';
import ActionLink from '../../components/ActionLink.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { schemaPageAssociation } from '../../modeles/page-editoriale';

const entree = await getEntry('pages', 'association');
if (!entree) throw new Error('Le singleton association est introuvable.');
const page = schemaPageAssociation.parse(entree.data);
const destinations = [
  { href: '/association/gouvernance', libelle: 'Voir la gouvernance' },
  { href: '/association/membres-fondateurs', libelle: 'Découvrir les membres fondateurs' },
  { href: '/association/nous-soutenir', libelle: 'Voir les manières de soutenir' },
] as const;
---
<BaseLayout title="Association — PPC" description={page.description}>
  <PageIntro eyebrow={page.surtitre} title={page.titre} intro={page.introduction} />
  <section class="mission"><SectionHeading eyebrow={page.mission.surtitre} title={page.mission.titre} /><p>{page.mission.texte}</p></section>
  <section class="pathways" aria-labelledby="titre-responsabilites"><h2 id="titre-responsabilites">{page.titre_liens}</h2><div class="links">{page.liens.map((lien, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{lien.titre}</h3><p>{lien.texte}</p><a href={destinations[index].href}>{destinations[index].libelle} <span aria-hidden="true">→</span></a></article>)}</div></section>
  <section class="contact"><h2>{page.contact.titre}</h2><p>{page.contact.texte}</p><ActionLink href="/contact">Nous contacter <span aria-hidden="true">→</span></ActionLink></section>
</BaseLayout>
<style>.mission{display:grid;gap:var(--space-5);padding-block:var(--space-section);border-top:var(--border-width) solid var(--color-border)}.mission>p{font-size:var(--font-size-lg)}.pathways{padding-block:var(--space-section);border-top:var(--border-width) solid var(--color-border)}.pathways>h2{color:var(--color-brand);font-family:var(--font-display);font-weight:400}.links{display:grid;gap:var(--space-6);margin-top:var(--space-7)}article{padding-top:var(--space-4);border-top:2px solid var(--color-brand)}article>span{color:var(--color-accent);font-size:var(--font-size-sm);font-weight:var(--font-weight-interface)}article h3{margin-block:var(--space-4) var(--space-3)}article p{color:var(--color-text-muted)}article a{font-weight:var(--font-weight-interface)}.contact{padding:var(--space-6);background:var(--color-surface-muted)}.contact h2{color:var(--color-brand);font-family:var(--font-display);font-weight:400}@media(min-width:48rem){.mission{grid-template-columns:.8fr 1.2fr;gap:var(--space-8)}.links{grid-template-columns:repeat(3,1fr)}} </style>
