---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ActionLink from '../components/ActionLink.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaPageComprendre } from '../modeles/page-editoriale';
import modeleLineaireVsPpc from '../../contenu/medias/images/pages/modele-lineaire-vs-ppc.webp';

const entree = await getEntry('pages', 'comprendre-la-ppc');
if (!entree) throw new Error('Le singleton comprendre-la-ppc est introuvable.');
const page = schemaPageComprendre.parse(entree.data);
const ancres = ['demarche', 'structure', 'cadre'] as const;
---
<BaseLayout title={`${page.titre} — PPC`} description={page.description}>
  <PageIntro eyebrow={page.surtitre} title={page.titre} intro={page.introduction} />
  <nav class="page-nav" aria-label="Dans cette page"><span>Dans cette page</span><a href="#demarche">La démarche</a><a href="#structure">Sa structure</a><a href="#cadre">Un cadre concret</a></nav>
  {page.sections.map((section, index) => <section id={ancres[index]} class="narrative"><SectionHeading eyebrow={section.surtitre} title={section.titre} /><div>{section.paragraphes.map((paragraphe) => <p>{paragraphe}</p>)}{index === 2 && <ActionLink href="/marque-collective">Découvrir la marque collective <span aria-hidden="true">→</span></ActionLink>}</div>{index === 0 && <figure class="section-illustration"><Image src={modeleLineaireVsPpc} alt="Comparaison entre le modèle industriel classique, qui perd de la valeur après l’usage et la fin de vie, et le modèle PPC, qui conserve la valeur grâce à la maintenance, la réparation et l’évolution du produit." widths={[720, 1152, 1672]} sizes="(min-width: 72rem) 76rem, 100vw" loading="lazy" /></figure>}</section>)}
  <section class="next"><p class="eyebrow">{page.poursuivre.surtitre}</p><h2>{page.poursuivre.titre}</h2><p>{page.poursuivre.texte}</p><ActionLink href="/ressources" secondary>Parcourir les ressources</ActionLink></section>
</BaseLayout>
<style>
  .page-nav { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); padding-block: var(--space-4); border-block: var(--border-width) solid var(--color-border); }.page-nav span { width: 100%; color: var(--color-text-muted); font-size: var(--font-size-sm); font-weight: var(--font-weight-interface); text-transform: uppercase; }
  .narrative { display: grid; gap: var(--space-5); padding-block: var(--space-section); border-bottom: var(--border-width) solid var(--color-border); scroll-margin-top: var(--space-7); }.narrative > div { font-size: var(--font-size-lg); }
  .section-illustration { margin: var(--space-3) 0 0; }
  .section-illustration :global(img) { display: block; width: 100%; height: auto; border: var(--border-width) solid var(--color-border); }
  .next { margin-top: var(--space-section); padding: var(--space-6); background: var(--color-surface-muted); }.next h2 { color: var(--color-brand); font-family: var(--font-display); font-weight: 400; }.eyebrow { color: var(--color-accent); font-size: var(--font-size-sm); font-weight: var(--font-weight-interface); text-transform: uppercase; }
  @media (min-width: 48rem) { .page-nav span { width: auto; margin-right: auto; }.narrative { grid-template-columns: minmax(15rem, .8fr) 1.2fr; gap: var(--space-8); }.section-illustration { grid-column: 1 / -1; width: min(76rem, calc(100vw - (2 * var(--space-5)))); margin-inline: auto; justify-self: center; } }
</style>
