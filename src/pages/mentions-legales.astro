---
import { getEntry, render } from 'astro:content';
import EditorialContent from '../components/EditorialContent.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaPageMarkdown } from '../modeles/page-editoriale';

const entree = await getEntry('pages', 'mentions-legales');
if (!entree) throw new Error('Le singleton mentions-legales est introuvable.');
const page = schemaPageMarkdown.parse(entree.data);
const { Content } = await render(entree);
---
<BaseLayout title="Mentions légales — PPC">
  <PageIntro eyebrow={page.surtitre} title={page.titre} intro={page.introduction} />
  <div class="legal"><EditorialContent><Content /></EditorialContent></div>
</BaseLayout>
<style>.legal{max-width:var(--width-reading);padding:var(--space-6);background:var(--color-surface-muted)}</style>
