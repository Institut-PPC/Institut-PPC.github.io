---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ActionLink from '../../components/ActionLink.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContentMeta from '../../components/ContentMeta.astro';
import EditorialContent from '../../components/EditorialContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formaterDate, libellesRessource } from '../../lib/contenus';
export async function getStaticPaths(){const entries=await getCollection('ressources',({data})=>data.publie&&data.mode_exposition==='page-interne');return entries.map((entry)=>({params:{slug:entry.data.mode_exposition==='page-interne'?entry.data.slug:''},props:{entry}}));}
interface Props{entry:CollectionEntry<'ressources'>}
const {entry}=Astro.props;if(entry.data.mode_exposition!=='page-interne')throw new Error('Une page de ressource requiert le mode page-interne.');const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.titre} — PPC`} description={entry.data.resume}>
  <Breadcrumb items={[{label:'Ressources',href:'/ressources'},{label:entry.data.titre}]} />
  <article><header class="content-header"><p class="eyebrow">{libellesRessource[entry.data.type]}</p><h1>{entry.data.titre}</h1><p class="lead">{entry.data.resume}</p><ContentMeta items={[entry.data.origine==='ppc'?'Ressource PPC':'Ressource externe',entry.data.date?formaterDate(entry.data.date):'']} />{entry.data.lien_principal_associe&&<ActionLink href={entry.data.lien_principal_associe}>Accéder à la ressource principale <span aria-hidden="true">↗</span></ActionLink>}</header>{entry.data.image&&<Image class="hero-image" src={entry.data.image} alt={entry.data.image_alt??''} widths={[720,1152]} sizes="(min-width:72rem) 72rem,100vw"/>}<EditorialContent><Content /></EditorialContent></article>
</BaseLayout>
<style>.content-header{max-width:var(--width-reading);padding-block:var(--space-4) var(--space-7)}.eyebrow{color:var(--color-accent);font-size:var(--font-size-sm);font-weight:var(--font-weight-interface);text-transform:uppercase;letter-spacing:.08em}h1{color:var(--color-brand);font-family:var(--font-display);font-size:var(--font-size-display);font-weight:400}.lead{font-size:var(--font-size-lg)}.hero-image{width:100%;margin-bottom:var(--space-8);border-radius:var(--radius-surface)}</style>
