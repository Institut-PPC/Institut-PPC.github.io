---
import { getCollection } from 'astro:content';
import ActualiteItem from '../components/ActualiteItem.astro';
import EmptyState from '../components/EmptyState.astro';
import EvenementItem from '../components/EvenementItem.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { evenementAVenir } from '../lib/contenus';
const actualites=(await getCollection('actualites',({data})=>data.publie)).sort((a,b)=>b.data.date_publication.localeCompare(a.data.date_publication));
const evenements=(await getCollection('evenements',({data})=>data.publie)).sort((a,b)=>b.data.date_debut.localeCompare(a.data.date_debut));
const aVenir=evenements.filter(({data})=>evenementAVenir(data.date_fin,data.date_debut)).reverse();
const passes=evenements.filter(({data})=>!evenementAVenir(data.date_fin,data.date_debut));
---
<BaseLayout title="Actualités & événements — PPC" description="Suivre les publications et les rendez-vous de la Pérennité Programmée Circulaire.">
  <PageIntro eyebrow="PPC en mouvement" title="Actualités & événements" intro="Retrouvez ici les actualités de l’Association, les avancées des travaux PPC et les événements auxquels l’écosystème de la Pérennité Programmée Circulaire participe." />
  <section class="stream" aria-labelledby="actualites"><h2 id="actualites">Actualités</h2><p class="intro">Publications, avancées des travaux, initiatives et informations liées au développement de la Pérennité Programmée Circulaire.</p>{actualites.length?actualites.map((actualite)=><ActualiteItem actualite={actualite}/>):<EmptyState title="Aucune actualité pour le moment" message="Les actualités de PPC seront présentées ici dès leur publication." />}</section>
  <section class="stream" aria-labelledby="evenements"><h2 id="evenements">Événements</h2><p class="intro">Conférences, rencontres et rendez-vous permettant d’échanger autour de PPC et des sujets qu’elle adresse : durabilité, économie de la fonctionnalité, circularité, industrie et préservation de la valeur dans le temps.</p>{aVenir.length>0&&<><h3 class="subheading">À venir</h3>{aVenir.map((evenement)=><EvenementItem evenement={evenement}/>)}</>}{passes.length>0&&<><h3 class="subheading">Événements passés</h3>{passes.map((evenement)=><EvenementItem evenement={evenement}/>)}</>}{!evenements.length&&<EmptyState title="Aucun événement annoncé" message="Aucun événement n’est annoncé pour le moment." />}</section>
</BaseLayout>
<style>.stream{padding-block:var(--space-section);border-top:var(--border-width) solid var(--color-border)}.stream>h2{color:var(--color-brand);font-family:var(--font-display);font-weight:400}.intro{margin-bottom:var(--space-7);font-size:var(--font-size-lg);color:var(--color-text-muted)}.subheading{margin-top:var(--space-7);font-size:var(--font-size-lg);text-transform:uppercase;letter-spacing:.06em}</style>
