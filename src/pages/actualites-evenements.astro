---
import PageIntro from '../components/PageIntro.astro';
import AgendaNotice from '../components/AgendaNotice.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { chargerAgenda } from '../lib/agenda-contenus';
import { classerEvenements, statutEvenement } from '../lib/agenda';
import '../styles/agenda.css';
const agenda = await chargerAgenda();
const {avenir, passes} = classerEvenements(agenda.evenements, agenda.maintenant);
---
<BaseLayout title="Actualités & événements — PPC" description="Suivre les publications et les rendez-vous de la Pérennité Programmée Circulaire.">
  <PageIntro eyebrow="PPC en mouvement" title="Actualités & événements" intro="Retrouvez ici les actualités de l’Association, les avancées des travaux PPC et les événements auxquels l’écosystème de la Pérennité Programmée Circulaire participe." />
  <div data-agenda>
    <div class="agenda-toolbar">
    <nav class="agenda-tabs" aria-label="Type de contenu">
      <a id="onglet-actualites" href="#actualites">Actualités</a>
      <a id="onglet-evenements" href="#evenements">Événements</a>
    </nav>
    <div hidden data-view-controls class="view-controls" role="group" aria-label="Présentation des événements">
      <button data-view="liste" aria-pressed="true" aria-label="Vue liste" title="Vue liste" aria-controls="evenements">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>
      </button>
      <button data-view="calendrier" aria-pressed="false" aria-label="Vue calendrier" title="Vue calendrier" aria-controls="evenements">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" /></svg>
      </button>
    </div>
    </div>
    <section id="actualites" class="agenda-panel" aria-labelledby="onglet-actualites">
      <h2 class="visually-hidden">Actualités</h2>
      <div data-list="actualites" class="news-grid">{agenda.actualites.slice(0,9).map(n => <AgendaNotice notice={n} />)}</div>
      {!agenda.actualites.length && <p>Aucune actualité pour le moment. Les publications de PPC seront présentées ici.</p>}
      <button hidden data-more="actualites">Afficher plus d’actualités</button>
      {agenda.actualites.length > 9 && <div data-fallback><h3>Toutes les actualités</h3><ul>{agenda.actualites.slice(9).map(n => <li><a href={`/actualites/${n.slug}`}>{n.titre}</a></li>)}</ul></div>}
    </section>
    <section id="evenements" class="agenda-panel" aria-labelledby="onglet-evenements">
      <h2 class="visually-hidden">Événements</h2>
      <div data-event-list>
        <section aria-labelledby="titre-avenir"><h3 id="titre-avenir">{avenir.some(e => statutEvenement(e, agenda.maintenant) === 'encours') ? 'En cours et à venir' : 'À venir'}</h3>
          <div data-list="avenir">{avenir.slice(0,6).map(n => <AgendaNotice notice={n} evenement />)}</div>
          {!avenir.length && <p>Aucun événement à venir pour le moment.</p>}
          <button hidden data-more="avenir">Afficher plus d’événements à venir</button>
        </section>
        <section aria-labelledby="titre-passes"><h3 id="titre-passes">Événements passés</h3>
          <div data-list="passes">{passes.slice(0,6).map(n => <AgendaNotice notice={n} evenement />)}</div>
          {!passes.length && <p>Aucun événement passé.</p>}
          <button hidden data-more="passes">Afficher plus d’événements passés</button>
        </section>
      </div>
      <section hidden data-calendar aria-label="Calendrier mensuel">
        <div class="calendar-toolbar">
          <button data-month="-1" aria-label="Mois précédent">←</button>
          <h3 data-month-title aria-live="polite"></h3>
          <button data-month="1" aria-label="Mois suivant">→</button>
          <button data-today>Aujourd’hui</button>
        </div>
        <div class="calendar-grid" data-calendar-grid></div>
        <div class="calendar-agenda">
          <button data-whole-month>Tout le mois</button>
          <h3 data-selection-title></h3>
          <div data-calendar-list></div>
        </div>
      </section>
      {(avenir.length > 6 || passes.length > 6) && <div data-fallback><h3>Autres événements</h3><ul>{[...avenir.slice(6),...passes.slice(6)].map(n => <li><a href={`/evenements/${n.slug}`}>{n.titre}</a></li>)}</ul></div>}
    </section>
    <p data-announcement class="visually-hidden" role="status"></p>
  </div>
  <script>
    import { initialiserAgenda } from '../components/agenda';
    initialiserAgenda();
  </script>
</BaseLayout>
