---
import { getEntry } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaPageContact } from '../modeles/page-editoriale';

const entree = await getEntry('pages', 'contact');
const configuration = await getEntry('configurationSite', 'site');
if (!entree) throw new Error('Le singleton contact est introuvable.');
if (!configuration) throw new Error('Le singleton configurationSite est introuvable.');
const page = schemaPageContact.parse(entree.data);
const coordonneesDisponibles = Boolean(configuration.data.adresse_postale || configuration.data.email_public);
---
<BaseLayout title="Contact — PPC" description={page.description}>
  <PageIntro eyebrow={page.surtitre} title={page.titre} intro={page.introduction} />
  <section class="contact-status"><h2>Coordonnées</h2>{coordonneesDisponibles ? <address>{configuration.data.adresse_postale && <p>{configuration.data.adresse_postale.map((ligne) => <>{ligne}<br /></>)}</p>}{configuration.data.email_public && <p><a href={`mailto:${configuration.data.email_public}`}>{configuration.data.email_public}</a></p>}</address> : <><p><strong>{page.coordonnees_absentes.titre}</strong></p><p>{page.coordonnees_absentes.texte}</p></>}</section>
  <section class="requests"><h2>{page.titre_demandes}</h2><div class="request-list">{page.demandes.map((demande) => <article><h3>{demande.titre}</h3><p>{demande.texte}</p></article>)}</div></section>
</BaseLayout>
<style>.contact-status{padding:var(--space-6);background:var(--color-surface-muted)}.contact-status h2,.requests>h2{color:var(--color-brand);font-family:var(--font-display);font-weight:400}.contact-status address{font-style:normal}.requests{padding-block:var(--space-section)}.request-list{display:grid;gap:var(--space-6)}article{padding-top:var(--space-4);border-top:var(--border-width) solid var(--color-border)}article h3{font-size:var(--font-size-lg)}article p{color:var(--color-text-muted)}@media(min-width:48rem){.request-list{grid-template-columns:1fr 1fr}} </style>
