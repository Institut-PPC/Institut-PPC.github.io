---
import { getEntry } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaPageEcoConception } from '../modeles/page-editoriale';

const entree = await getEntry('pages', 'eco-conception');
if (!entree) throw new Error('Le singleton eco-conception est introuvable.');
const page = schemaPageEcoConception.parse(entree.data);
const classes = ['A', 'B', 'C', 'D', 'E', 'F', 'G'] as const;
const seuils = [75, 55, 40, 25, 15, 5, 0] as const;
const classeObtenue = classes[seuils.findIndex((seuil) => page.mesure.score >= seuil)];
---

<BaseLayout
  title={`${page.titre} — PPC`}
  description={page.description}
>
  <PageIntro
    eyebrow={page.surtitre}
    title={page.titre}
    intro={page.introduction}
  />

  <div class="introduction">
    {page.introduction_detaillee.map((paragraphe) => <p>{paragraphe}</p>)}
  </div>

  <section class="section">
    <SectionHeading eyebrow={page.enjeu.surtitre} title={page.enjeu.titre} />
    <div class="section-content">
      <p>{page.enjeu.chiffres[0]} <strong>{page.enjeu.chiffres[1]}</strong> {page.enjeu.chiffres[2]} <strong>{page.enjeu.chiffres[3]}</strong>{page.enjeu.chiffres[4]} <strong>{page.enjeu.chiffres[5]}</strong>{page.enjeu.chiffres[6]}</p>
      <p>{page.enjeu.poids_pages[0]} <strong>{page.enjeu.poids_pages[1]}</strong> {page.enjeu.poids_pages[2]} <strong>{page.enjeu.poids_pages[3]}</strong>{page.enjeu.poids_pages[4]}</p>
      <blockquote>
        <p>{page.enjeu.citation}</p>
      </blockquote>
      <p class="sources">Sources : {page.enjeu.sources.map((source, index) => <>{index > 0 && ' ; '}<a href={source.url}>{source.libelle}</a></>)}.</p>
    </div>
  </section>

  <section class="section">
    <SectionHeading eyebrow={page.conception.surtitre} title={page.conception.titre} />
    <div class="section-content">
      <div class="choices">
        {page.conception.choix.map((choix) => (
          <article>
            <h3>{choix.titre}</h3>
            <p>{choix.texte}</p>
          </article>
        ))}
      </div>
      <p class="conclusion">{page.conception.conclusion}</p>
    </div>
  </section>

  <section class="section measure">
    <SectionHeading eyebrow={page.mesure.surtitre} title={page.mesure.titre} />
    <div class="section-content">
      <p>{page.mesure.introduction}</p>
      <div class="score">
        <div class="scale-labels" aria-hidden="true"><span>max. 100</span><span>min. 0</span></div>
        <ol class="scale" aria-label="Classement EcoIndex de A à G">
          {classes.map((classe) => <li class:list={[`grade-${classe.toLowerCase()}`, { active: classe === classeObtenue }]} aria-current={classe === classeObtenue ? 'true' : undefined}><span>{classe}</span>{classe === classeObtenue && <small>Classe obtenue</small>}</li>)}
        </ol>
        <p class="score-value"><span>Score EcoIndex</span> <strong>{page.mesure.score} <small>/ 100</small></strong></p>
      </div>
      <p><a href={page.mesure.url_resultat}>{page.mesure.texte_lien}</a>.</p>
      {page.mesure.suivi.map((paragraphe) => <p>{paragraphe}</p>)}
    </div>
  </section>
</BaseLayout>

<style>
  .introduction { max-width: var(--width-reading); padding-bottom: var(--space-section); font-size: var(--font-size-lg); }
  .section { display: grid; gap: var(--space-5); padding-block: var(--space-section); border-top: var(--border-width) solid var(--color-border); }
  .section-content { min-width: 0; }
  .section-content > :last-child { margin-bottom: 0; }
  blockquote { margin-block: var(--space-7); }
  .sources { color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .choices { display: grid; gap: var(--space-4); }
  .choices article { padding: var(--space-5); background: var(--color-surface-muted); }
  .choices h3 { margin-bottom: var(--space-3); color: var(--color-brand); font-family: var(--font-display); font-weight: 400; }
  .choices p { margin-bottom: 0; }
  .conclusion { margin-top: var(--space-6); font-size: var(--font-size-lg); }
  .measure { border-bottom: var(--border-width) solid var(--color-border); }
  .score { margin-block: var(--space-6); padding: var(--space-5); background: var(--color-surface); color: var(--color-text); }
  .scale-labels { display: flex; justify-content: space-between; margin-bottom: var(--space-1); color: var(--color-text-muted); font-size: var(--font-size-sm); font-style: italic; }
  .scale { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding: 0; margin: 0; list-style: none; }
  .scale li { position: relative; display: grid; place-items: center; min-width: 0; height: 4.5rem; padding-top: var(--space-3); border-top: .7rem solid; font-size: var(--font-size-xl); font-weight: var(--font-weight-interface); line-height: 1; }
  .scale .active { min-height: 6.25rem; padding-top: 0; border-top: 0; border-radius: var(--radius-surface); color: var(--color-on-brand); }
  .scale small { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .scale .grade-a { border-top-color: #2f9e44; }.scale .grade-a.active { background: #2f9e44; }
  .scale .grade-b { border-top-color: #39b86c; }.scale .grade-c { border-top-color: #bfdc00; }
  .scale .grade-d { border-top-color: #ffe500; }.scale .grade-e { border-top-color: #ffc400; }
  .scale .grade-f { border-top-color: #ff9826; }.scale .grade-g { border-top-color: #ef2525; }
  .score-value { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin: var(--space-5) 0 0; color: var(--color-brand); }
  .score-value > span { font-size: var(--font-size-lg); font-weight: var(--font-weight-interface); }
  .score-value strong { font-family: var(--font-display); font-size: var(--font-size-2xl); font-weight: 400; }
  .score-value small { font-family: var(--font-body); font-size: var(--font-size-md); }
  @media (max-width: 30rem) {
    .score { padding-inline: var(--space-4); }
    .scale li { height: 3.75rem; font-size: var(--font-size-lg); }
    .scale .active { min-height: 5.25rem; }
  }
  @media (min-width: 48rem) {
    .section { grid-template-columns: minmax(15rem, .8fr) 1.2fr; gap: var(--space-8); }
    .choices { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
