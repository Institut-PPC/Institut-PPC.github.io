---
import { getEntry, render } from 'astro:content';
import EditorialContent from '../components/EditorialContent.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaPageMarkdown } from '../modeles/page-editoriale';

const entree = await getEntry('pages', 'politique-de-confidentialite');
if (!entree) throw new Error('Le singleton politique-de-confidentialite est introuvable.');
const page = schemaPageMarkdown.parse(entree.data);
const { Content } = await render(entree);
---
<BaseLayout title="Politique de confidentialité — PPC" description={page.description}>
  <PageIntro eyebrow={page.surtitre} title={page.titre} intro={page.introduction} />
  <div class="legal"><EditorialContent><Content /></EditorialContent></div>
</BaseLayout>
<style>.legal{max-width:var(--width-reading)}</style>
