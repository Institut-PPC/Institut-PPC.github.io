---
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  socialImage?: ImageMetadata | string;
}

const { title, description, socialImage } = Astro.props;
const configuration = await getEntry('configurationSite', 'site');
const siteName = 'Pérennité Programmée Circulaire';

if (!Astro.site) {
  throw new Error('La propriété site doit être définie dans astro.config.mjs.');
}
if (!description) {
  throw new Error(`La page « ${title} » doit fournir une description pour ses métadonnées SEO.`);
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const sitemapUrl = new URL('/sitemap-index.xml', Astro.site);
const socialImageUrl = socialImage
  ? new URL(typeof socialImage === 'string' ? socialImage : socialImage.src, Astro.site)
  : undefined;

if (!configuration) {
  throw new Error('Le singleton contenu/configuration/site.yaml est introuvable.');
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu-principal">Aller au contenu principal</a>
    <div class="site-shell grid">
      <Header identite={configuration.data.identite} />
      <main id="contenu-principal" class="py-section" tabindex="-1">
        <div class="w-full max-w-content mx-auto px-gutter">
          <slot />
        </div>
      </main>
      <Footer
        identite={configuration.data.identite}
        reseauxSociaux={configuration.data.reseaux_sociaux ?? []}
      />
    </div>
  </body>
</html>

<style>
  .site-shell {
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-3) var(--space-4);
    color: var(--color-on-brand);
    background: var(--color-brand);
    border-radius: var(--radius-control);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
