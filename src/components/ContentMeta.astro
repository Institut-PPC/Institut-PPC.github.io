---
interface Props { items: string[]; }
const { items } = Astro.props;
---
<ul class="meta" aria-label="Informations sur le contenu">
  {items.filter(Boolean).map((item) => <li>{item}</li>)}
</ul>
<style>
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: 0; margin: 0 0 var(--space-4); color: var(--color-text-muted); font-size: var(--font-size-sm); list-style: none; }
  li + li::before { content: '•'; margin-right: var(--space-4); color: var(--color-accent); }
</style>
