---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
  date: string;
  title: string;
  href: string;
  summary: string;
}

const { image, imageAlt, date, title, href, summary } = Astro.props;
---
<article class="home-content-card">
  {image && <Image src={image} alt={imageAlt ?? ''} widths={[480, 768]} sizes="(min-width: 48rem) 36rem, 100vw" />}
  <div class="content">
    <p class="date">{date}</p>
    <h4><a href={href}>{title}</a></h4>
    <p class="summary">{summary}</p>
  </div>
</article>
<style>
  .home-content-card {
    overflow: hidden;
    padding-top: var(--space-2);
    border-top: var(--border-width) solid var(--color-border);
  }

  img {
    aspect-ratio: 3 / 2;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-surface);
  }

  .content { padding-top: var(--space-4); }

  .date {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-interface);
  }

  h4 { margin-bottom: var(--space-3); }
  h4 a { color: var(--color-brand); }

  .summary {
    display: -webkit-box;
    max-height: calc(4 * 1.6em);
    overflow: hidden;
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }
</style>
