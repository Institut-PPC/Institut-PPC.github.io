---
interface Props { title: string; message: string; }
const { title, message } = Astro.props;
---
<div class="empty-state">
  <span aria-hidden="true">○</span>
  <div><h3>{title}</h3><p>{message}</p></div>
</div>
<style>
  .empty-state { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); max-width: var(--width-reading); padding-block: var(--space-5); border-block: var(--border-width) solid var(--color-border); }
  .empty-state > span { color: var(--color-accent); font-size: var(--font-size-xl); line-height: 1.3; }
  h3 { margin-bottom: var(--space-2); font-size: var(--font-size-lg); }
  p { margin: 0; color: var(--color-text-muted); }
</style>
