---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { normaliserRolesPersonCard } from './person-card';

interface Props { personne: CollectionEntry<'personnes'>; role?: string; roles?: readonly string[]; }
const { personne, role, roles } = Astro.props;
const nom = `${personne.data.prenom} ${personne.data.nom}`;
const rolesAffiches = normaliserRolesPersonCard({ role, roles });
---
<article class="person-card">
  {personne.data.photo && (personne.data.linkedin
    ? <a class="photo-link" href={personne.data.linkedin} aria-label={`Profil LinkedIn de ${nom}`}>
        <Image src={personne.data.photo} alt="" widths={[112, 224]} sizes="clamp(5rem, 18vw, 7rem)" />
      </a>
    : <Image src={personne.data.photo} alt="" widths={[112, 224]} sizes="clamp(5rem, 18vw, 7rem)" />)}
  <div>
    <h3>{nom}</h3>
    {rolesAffiches.map((libelle) => <p class="role">{libelle}</p>)}
    {personne.data.fonction_organisation && <p>{personne.data.fonction_organisation}</p>}
  </div>
</article>
<style>
  .person-card { border-top: var(--border-width) solid var(--color-border); padding-top: var(--space-4); }
  .photo-link { display: block; width: fit-content; }
  img { aspect-ratio: 1; width: clamp(5rem, 18vw, 7rem); margin-bottom: var(--space-4); object-fit: cover; border-radius: 50%; }
  h3 { margin-bottom: var(--space-2); color: var(--color-brand); }
  p { margin-bottom: var(--space-2); color: var(--color-text-muted); }
  .role { color: var(--color-text); font-weight: var(--font-weight-interface); }
</style>
