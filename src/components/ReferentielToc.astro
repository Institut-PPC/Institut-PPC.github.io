---
import type { EntreePlanReferentiel } from '../lib/referentiel-ppc';

interface Props {
  chapitres: EntreePlanReferentiel[];
  variante: 'desktop' | 'mobile';
}

const { chapitres, variante } = Astro.props;
---

<nav class:list={['referentiel-toc', `referentiel-toc--${variante}`]} aria-label="Sommaire du Référentiel">
  <ol>
    {chapitres.map((chapitre, index) => (
      <li data-toc-chapter={chapitre.id}>
        <a href={`#${chapitre.id}`} data-chapter-link aria-current={index === 0 ? 'location' : undefined}>
          {chapitre.titre}
        </a>
        <ol data-subsections-for={chapitre.id} hidden={index !== 0}>
          {chapitre.sousSections.map((sousSection) => (
            <li><a href={`#${sousSection.id}`} data-section-link>{sousSection.titre}</a></li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
</nav>

<style>
  ol { padding: 0; margin: 0; list-style: none; }
  .referentiel-toc > ol { display: grid; gap: var(--space-1); }
  a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-left: 0.2rem solid transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.4;
    text-decoration: none;
  }
  a:hover { color: var(--color-link-hover); text-decoration: underline; }
  a[aria-current='location'] {
    border-left-color: var(--color-accent);
    color: var(--color-brand);
    font-weight: var(--font-weight-interface);
  }
  [data-subsections-for] {
    margin: var(--space-1) 0 var(--space-3) var(--space-4);
    border-left: var(--border-width) solid var(--color-border);
  }
  [data-subsections-for] a { padding-block: var(--space-1); }
  [hidden] { display: none !important; }
</style>
